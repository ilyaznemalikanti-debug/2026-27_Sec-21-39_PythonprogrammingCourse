a=6
b=9
print("Addition:", a + b)  #addition operation
print("Subtraction:", a - b)    #subtraction operation
print("Multiplication:", a * b)     #multiplication operation
print("Division:", a / b)  #division operation
print("Floor Division:", a // b)  #floor division operation
print("Modulus:", a % b)  #modulus operation
print("Exponentiation:", a ** b)  #exponentiation operation